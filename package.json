{
  "name": "herdr-plugin-auto-rename",
  "version": "0.4.0",
  "description": "Rename fresh Herdr worktrees and Git branches from a coding agent's first prompt.",
  "type": "module",
  "keywords": [
    "herdr-plugin",
    "pi-package",
    "codex-plugin",
    "git-worktree"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/tests/**/*.test.js",
    "clean": "rm -rf dist"
  },
  "pi": {
    "extensions": [
      "./src/extensions/pi.ts"
    ]
  },
  "dependencies": {
    "smol-toml": "^1.7.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.82.0",
    "@earendil-works/pi-coding-agent": "^0.82.0",
    "@types/node": "^22.15.0",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/khatriafaz/herdr-plugin-auto-rename.git"
  },
  "homepage": "https://github.com/khatriafaz/herdr-plugin-auto-rename#readme",
  "bugs": {
    "url": "https://github.com/khatriafaz/herdr-plugin-auto-rename/issues"
  },
  "license": "MIT"
}
